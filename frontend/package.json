{
  "name": "bcit-issp-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sbom": "npm sbom --sbom-format cyclonedx --package-lock-only > sbom.cyclonedx.json",
    "sbom:prod": "npm sbom --sbom-format cyclonedx --package-lock-only --omit dev > sbom-production.cyclonedx.json",
    "sbom:spdx": "npm sbom --sbom-format spdx --package-lock-only > sbom.spdx.json"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@tanstack/react-query": "^5.100.10",
    "classnames": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
